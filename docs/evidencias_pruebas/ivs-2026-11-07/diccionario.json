  "constraints": [
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_accepted_devices_check",
      "definition": "CHECK ((accepted_devices >= 0))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_attempts_check",
      "definition": "CHECK ((attempts >= 0))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_claim_consistent",
      "definition": "CHECK (((((status)::text = 'CLAIMED'::text) AND (claimed_at IS NOT NULL) AND (claim_token IS NOT NULL)) OR (((status)::text <> 'CLAIMED'::text) AND (claimed_at IS NULL) AND (claim_token IS NULL))))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_completion_consistent",
      "definition": "CHECK ((((status)::text = ANY ((ARRAY['SENT'::character varying, 'SKIPPED'::character varying, 'FAILED'::character varying])::text[])) = (completed_at IS NOT NULL)))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_kind_check",
      "definition": "CHECK (((kind)::text = 'ATTENDANCE_REMINDER'::text))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_sent_consistent",
      "definition": "CHECK ((((status)::text = 'SENT'::text) = (sent_at IS NOT NULL)))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_source_check",
      "definition": "CHECK (((source)::text = 'ADMIN_MANUAL'::text))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "appointment_notification_jobs_status_check",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['QUEUED'::character varying, 'CLAIMED'::character varying, 'SENT'::character varying, 'SKIPPED'::character varying, 'FAILED'::character varying])::text[])))"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "fk_appointment_notification_jobs_appointment",
      "definition": "FOREIGN KEY (appointment_id) REFERENCES appointments(id) ON DELETE CASCADE"
    },
    {
      "table_name": "appointment_notification_jobs",
      "name": "fk_appointment_notification_jobs_requester",
      "definition": "FOREIGN KEY (requested_by_user_id) REFERENCES users(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "appointments",
      "name": "appointments_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "appointments",
      "name": "appointments_reminder_claim_consistent",
      "definition": "CHECK (((reminder_claimed_at IS NULL) = (reminder_claim_token IS NULL)))"
    },
    {
      "table_name": "appointments",
      "name": "appointments_reminder_claim_eligible_state",
      "definition": "CHECK (((reminder_claim_token IS NULL) OR (((status)::text = 'ACCEPTED'::text) AND (client_attendance_confirmed_at IS NULL) AND (reminder_sent_at IS NULL))))"
    },
    {
      "table_name": "appointments",
      "name": "appointments_status_check",
      "definition": "CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'ACCEPTED'::character varying, 'COMPLETED'::character varying, 'REJECTED'::character varying, 'CANCELLED'::character varying])::text[])))"
    },
    {
      "table_name": "appointments",
      "name": "fk_appointments_user",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE RESTRICT"
    },
    {
      "table_name": "push_device_tokens",
      "name": "fk_push_device_tokens_user",
      "definition": "FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"
    },
    {
      "table_name": "push_device_tokens",
      "name": "push_device_tokens_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "push_device_tokens",
      "name": "push_device_tokens_platform_check",
      "definition": "CHECK (((platform)::text = ANY ((ARRAY['android'::character varying, 'ios'::character varying])::text[])))"
    },
    {
      "table_name": "push_device_tokens",
      "name": "push_device_tokens_token_not_blank",
      "definition": "CHECK ((length(btrim(expo_push_token)) > 0))"
    },
    {
      "table_name": "users",
      "name": "users_phone_key",
      "definition": "UNIQUE (phone)"
    },
    {
      "table_name": "users",
      "name": "users_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table_name": "users",
      "name": "users_role_check",
      "definition": "CHECK (((role)::text = ANY ((ARRAY['CLIENT'::character varying, 'ADMIN'::character varying])::text[])))"
    }
  ],
