{
  "expo": {
    "name": "Barbería Cale",
    "slug": "barberia-cale",
    "version": "1.0.0",
    "description": "Reserva y administra citas en Barbería Cale.",
    "orientation": "portrait",
    "backgroundColor": "#F4EFE6",
    "icon": "./assets/images/logo-cale.png",
    "scheme": "barberiacale",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo-cale.png"
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.hanssel957.barberiacale"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-cale.png",
      "lang": "es-NI",
      "themeColor": "#743B2F",
      "backgroundColor": "#F4EFE6",
      "description": "Reserva y administra citas en Barbería Cale."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo-cale.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc348e3d-96c8-49ff-88ba-06ab1d4799ea"
      }
    }
  }
}
